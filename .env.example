# Copy to .env and change both values, or run ./scripts/quickstart.sh to generate them.
# .env is git-ignored.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Bearer token clients send to the HTTP server (docker compose `mcp` service).
MCP_AUTH_TOKEN=change-me-too
